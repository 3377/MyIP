{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/_api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/_api/all-location",
      "destination": "/functions/_api/all-location.js"
    },
    {
      "source": "/_api/public-ip",
      "destination": "/functions/_api/public-ip.js"
    },
    {
      "source": "/_api/ip-info",
      "destination": "/functions/_api/ip-info.js"
    }
  ],
  "headers": [
    {
      "source": "/_api/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    }
  ]
} 